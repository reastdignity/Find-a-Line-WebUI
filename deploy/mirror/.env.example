# Settings of the mirror stack (compose.yaml next to this file). Copy to .env and fill in; .env
# stays on the server (never in the repository).

# The host folder that holds public/ (served, read-only), logs/ (the request log, owned by uid
# 101), staging/ and trash/ (the publish tool's). All four on one file system, on a path that does
# not pass a FUSE layer, on storage that never spins down (README.md, "Storage").
MIRROR_ROOT=/srv/findaline-mirror

# The contact for abuse and takedown requests, shown on the landing page (an e-mail address).
MIRROR_CONTACT=

# The site's server: at most four single IPv4 addresses, comma-separated, with the trusted class's
# limits (16 MB/s a request, 4 at once, outside the visitors' total). Empty: none. A network, a
# fifth address or anything else refuses to start.
MIRROR_TRUSTED_ADDRESSES=

# The project's own Docker network (internal). Change it only if it collides with another network
# of the machine; X-Real-IP is believed from any sender on it.
MIRROR_SUBNET=172.29.42.0/24

# Memory of the container (also its memory with swap).
MIRROR_MEMORY=128m
