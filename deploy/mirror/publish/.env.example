# Settings of the mirror's publishing door (compose.yaml next to this file). Copy to .env and fill in;
# .env stays on the server.

# The same folder as MIRROR_ROOT of the mirror's .env (holding public/, staging/, trash/, logs/),
# mounted whole at /mirror.
MIRROR_ROOT=/srv/findaline-mirror

# A folder outside the repository copy holding authorized_keys (the publishing key's public half)
# and ssh_host_ed25519_key (the door's host key, owned by uid 1000, mode 600): README.md of
# deploy/mirror, "The publishing account".
PUBLISH_KEYS=/srv/findaline-mirror-keys

# The join code of the dedicated Husarnet network that holds only the publishing PC and this door
# (from Husarnet's dashboard). A SECRET: anyone with it can add a device to that network. Needed for
# the first join only: once the door is joined (its state folder kept) it may be removed from here;
# until then it is visible to root of the server (`docker inspect`; for up to 30 s at the join, the
# process list). Never in the repository, a log or a message; keep this file mode 600.
HUSARNET_JOIN_CODE=

# The name the door shows in Husarnet's dashboard and to its peers.
HUSARNET_HOSTNAME=findaline-mirror-door

# A folder outside the repository copy for the Husarnet sidecar's state (/var/lib/husarnet): the
# device's private key, its licence file and the daemon's API token. Made once, owned by root, mode
# 0700. Keep it: a new one is a new device with another Husarnet address.
HUSARNET_STATE=/srv/findaline-mirror-husarnet
