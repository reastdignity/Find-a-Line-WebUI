# Variables of the monitoring project's compose.yaml (next to this file). deploy/vps.sh writes
# .env here (git-ignored) from the host's groups; both are required.

# The group of /var/run/docker.sock on the host (getent group docker): the socket proxy's group
DOCKER_GID=999
# The group adm (4 on Ubuntu): Telegraf reads nginx's logs (0640 www-data adm)
ADM_GID=4
