    },
    {
      "id": 18,
      "type": "stat",
      "title": "Failing (F11)",
      "description": "Outside services with more than 20 % of their requests failed in the last 30 min (at least 10 requests), as the alert F11.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "count((((sum by (host) (findaline_service_requests_total{outcome!~\"ok|not_found\"}) or sum by (host) (findaline_service_requests_total) * 0) - (sum by (host) (findaline_service_requests_total{outcome!~\"ok|not_found\"} offset 30m) or sum by (host) (findaline_service_requests_total) * 0 and on () max(findaline_build_info offset 30m))) / (sum by (host) (findaline_service_requests_total) - (sum by (host) (findaline_service_requests_total offset 30m) or sum by (host) (findaline_service_requests_total) * 0 and on () max(findaline_build_info offset 30m))) * 100 and (sum by (host) (findaline_service_requests_total) - (sum by (host) (findaline_service_requests_total offset 30m) or sum by (host) (findaline_service_requests_total) * 0 and on () max(findaline_build_info offset 30m))) >= 10) > 20) or vector(0)",
          "legendFormat": "hosts",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "none"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
