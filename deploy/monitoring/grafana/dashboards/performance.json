{
  "uid": "performance",
  "title": "Data and computing",
  "description": "Where the worker's time goes: the requests to outside services, the speed of the elevation layers' downloads and the cache, the Mpx computed, the seconds per Mpx, the steps and stages of computing and the funnel of the line search (docs/monitoring.md, rows F11, F18, F19).",
  "tags": [
    "findaline"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "enable": true,
        "iconColor": "#8F8F8F",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "expr": "count by (version) (findaline_build_info) unless count by (version) (findaline_build_info offset 5m)",
        "step": "1m",
        "titleFormat": "Version {{version}}",
        "textFormat": "",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
