  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "At a glance (F11, F18, F19)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
