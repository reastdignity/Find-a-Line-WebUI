    {
      "id": 14,
      "type": "stat",
      "title": "Area today (F14, F18)",
      "description": "km\u00b2 of the searches finished in the last 24 hours (computed; in total: the panel to the right) and km\u00b2 of new terrain data downloaded for them (the rest came from the cache).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "(sum(findaline_area_km2_total) or max(findaline_build_info) * 0) - (sum(findaline_area_km2_total offset 24h) or max(findaline_build_info offset 24h) * 0)",
          "legendFormat": "computed",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B",
          "expr": "(sum(findaline_download_km2_total{role=\"terrain\"}) or max(findaline_build_info) * 0) - (sum(findaline_download_km2_total{role=\"terrain\"} offset 24h) or max(findaline_build_info offset 24h) * 0)",
          "legendFormat": "downloaded",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: km\u00b2",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "noValue": "no metrics"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
