{
  "uid": "use",
  "title": "Use",
  "description": "Who uses the site and how much: accounts, sessions and actions, problem reports, the area searched by day and country, users by country, favourite lines and the coverage map (docs/monitoring.md, rows F6-F8, F14-F17).",
  "tags": [
    "findaline"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "enable": true,
        "iconColor": "#8F8F8F",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "expr": "count by (version) (findaline_build_info) unless count by (version) (findaline_build_info offset 5m)",
        "step": "1m",
        "titleFormat": "Version {{version}}",
        "textFormat": "",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/overview",
      "icon": "dashboard",
      "keepTime": true
