          "refId": "A",
          "expr": "(sum(findaline_jobs_finished_total{error=\"internal\"}) or max(findaline_build_info) * 0) - (sum(findaline_jobs_finished_total{error=\"internal\"} offset 24h) or max(findaline_build_info offset 24h) * 0)",
          "legendFormat": "__auto",
