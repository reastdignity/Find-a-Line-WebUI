          "refId": "A",
          "expr": "((sum(findaline_jobs_finished_total{status=\"failed\"}) or max(findaline_build_info) * 0) - (sum(findaline_jobs_finished_total{status=\"failed\"} offset 1h) or max(findaline_build_info offset 1h) * 0)) / ((sum(findaline_jobs_finished_total) or max(findaline_build_info) * 0) - (sum(findaline_jobs_finished_total offset 1h) or max(findaline_build_info offset 1h) * 0)) * 100",
