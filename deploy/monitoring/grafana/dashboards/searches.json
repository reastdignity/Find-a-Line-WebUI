{
  "uid": "searches",
  "title": "Searches",
  "description": "The work of the application: the queue and the worker, the searches finished and their errors, the quick lane and the housekeeping (docs/monitoring.md, rows F1-F5, F13).",
  "tags": [
    "findaline"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "enable": true,
        "iconColor": "#8F8F8F",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "expr": "count by (version) (findaline_build_info) unless count by (version) (findaline_build_info offset 5m)",
        "step": "1m",
        "titleFormat": "Version {{version}}",
        "textFormat": "",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
