{
  "uid": "logs",
  "title": "Logs",
  "description": "The lines of web, worker and nginx's error log (addresses masked) of the last 30 days, from VictoriaLogs (docs/monitoring.md, \"The logs\").",
  "tags": [
    "findaline"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "type": "custom",
        "query": "web,worker,nginx",
        "multi": true,
        "includeAll": true,
        "allValue": "",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "web",
            "value": "web",
            "selected": false
          },
          {
            "text": "worker",
            "value": "worker",
            "selected": false
          },
          {
            "text": "nginx",
            "value": "nginx",
            "selected": false
          }
        ],
        "hide": 0
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,warning,info",
        "multi": true,
        "includeAll": true,
        "allValue": "",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "error",
            "value": "error",
            "selected": false
          },
          {
            "text": "warning",
            "value": "warning",
            "selected": false
          },
          {
            "text": "info",
            "value": "info",
            "selected": false
          }
        ],
        "hide": 0
      },
      {
        "name": "search",
        "label": "Text",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/overview",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "VPS",
      "type": "link",
      "url": "/d/vps",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Site",
      "type": "link",
      "url": "/d/site",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Searches",
      "type": "link",
      "url": "/d/searches",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Use",
      "type": "link",
      "url": "/d/use",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Data and computing",
      "type": "link",
      "url": "/d/performance",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error lines per 5 minutes",
      "description": "Lines of level error by source (the application: exceptions, tracebacks, internal errors; nginx: error, crit, alert, emerg).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "source:$source level:error | stats by (source) count() lines",
          "queryType": "statsRange",
          "legendFormat": "{{source}}"
        }
      ],
      "interval": "5m",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Lines per 5 minutes by level",
      "description": "All lines of the chosen sources.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "source:$source level:$level | stats by (level) count() lines",
          "queryType": "statsRange",
          "legendFormat": "{{level}}"
        }
      ],
      "interval": "5m",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Lines",
      "description": "Newest first; filtered by source, level and the text (a LogsQL word or phrase).",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "source:$source level:$level $search",
          "queryType": "instant"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
