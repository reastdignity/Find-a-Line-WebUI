        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API p95, 5 min (C2)",
      "description": "95th percentile of nginx's request time of /api/ (event streams not included). Alert above 2 s for 10 min.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "max(avg_over_time(nginx_times_request_time_095{group=\"api\"}[5m]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
