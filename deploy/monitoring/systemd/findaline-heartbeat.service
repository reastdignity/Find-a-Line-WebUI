# Find-a-Line monitoring: the heartbeat (deploy/monitoring/heartbeat.sh) every minute from
# findaline-heartbeat.timer: the site through nginx, then healthchecks.io's ping. deploy/vps.sh
# installs it into /etc/systemd/system with the checkout's path in place of @REPO@
# (docs/deployment.md, section 15).
[Unit]
Description=Find-a-Line monitoring: heartbeat to healthchecks.io while the site answers
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
# HEARTBEAT_URL; systemd reads the file (root, 0600) before it starts the script
EnvironmentFile=-/etc/findaline-monitoring.env
ExecStart=/bin/bash @REPO@/deploy/monitoring/heartbeat.sh
TimeoutStartSec=50s
# A throwaway user that can read the checkout (findaline.env) and use the network, nothing else
DynamicUser=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
