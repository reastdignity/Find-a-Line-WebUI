# Find-a-Line monitoring: the facts only root can read (deploy/monitoring/facts.sh), every 5
# minutes from findaline-facts.timer. deploy/vps.sh installs it into /etc/systemd/system with the
# checkout's path in place of @REPO@ (docs/deployment.md, section 15).
[Unit]
Description=Find-a-Line monitoring: facts of the host (fail2ban, disk image, updates)
After=fail2ban.service

[Service]
Type=oneshot
ExecStart=/bin/bash @REPO@/deploy/monitoring/facts.sh
TimeoutStartSec=2min
# /var/lib/findaline-monitoring (0755), made by systemd if missing; the only place it writes
StateDirectory=findaline-monitoring
StateDirectoryMode=0755
UMask=0022
# Root for fail2ban's socket and the disk image's mode 0600, but without capabilities, network
# (the socket is a file) or anything else to write
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
